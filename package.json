{
  "name": "clapgrid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx src/service/main.ts --dev",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "start": "node dist/service/main.js",
    "runtime": "node dist/runtime.js",
    "mcp": "node dist/mcp/main.js",
    "plugin:build": "npm run build && node scripts/build-plugin.mjs",
    "check": "node scripts/check.mjs",
    "diagnose:identity": "node scripts/diagnose-identity.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
