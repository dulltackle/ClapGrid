{
  "name": "clapgrid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx src/service/main.ts --dev",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "start": "node dist/service/main.js",
    "runtime": "node dist/runtime.js",
    "mcp": "node dist/mcp/main.js",
    "plugin:build": "npm run build && node scripts/build-plugin.mjs",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/verify.mjs",
    "styles:check": "tsx --test --test-concurrency=1 tests/style-collisions.test.ts tests/row-menu-panel.test.ts tests/selection-menu-panel.test.ts",
    "review:check": "node scripts/check-review-links.mjs",
    "plugin:update": "node scripts/update-plugin.mjs",
    "plugin:verify": "node scripts/diagnose-identity.mjs --require-current",
    "diagnose:identity": "node scripts/diagnose-identity.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
