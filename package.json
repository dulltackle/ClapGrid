{
  "name": "clapgrid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx src/service/main.ts --dev",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.production.json",
    "test": "node scripts/test-runner.mjs",
    "test:native:logic": "node scripts/test-runner.mjs --suite native-logic",
    "test:native:service": "node scripts/test-runner.mjs --suite native-service",
    "check:ui:native": "node scripts/check-ui.mjs --scope row --native",
    "test:rows": "node scripts/test-runner.mjs --suite rows",
    "test:tooling": "node scripts/test-runner.mjs --suite tooling",
    "test:failed": "node scripts/test-runner.mjs --suite failed",
    "check:preflight": "node scripts/check.mjs --preflight",
    "check:failed": "node scripts/check.mjs --failed",
    "check:stop": "node scripts/check-lifecycle.mjs",
    "start": "node dist/service/main.js",
    "runtime": "node dist/runtime.js",
    "mcp": "node dist/mcp/main.js",
    "plugin:build": "npm run build && node scripts/build-plugin.mjs",
    "check": "node scripts/check.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "verify": "node scripts/verify.mjs",
    "styles:check": "node scripts/test-runner.mjs --suite styles --files '[\"tests/style-collisions.test.ts\",\"tests/row-menu-panel.test.ts\",\"tests/selection-menu-panel.test.ts\"]'",
    "review:check": "node scripts/check-review-links.mjs",
    "plugin:update": "node scripts/update-plugin.mjs",
    "plugin:verify": "node scripts/diagnose-identity.mjs --require-current",
    "diagnose:identity": "node scripts/diagnose-identity.mjs",
    "production": "node scripts/production.mjs",
    "test:logic": "node scripts/test-runner.mjs --suite logic",
    "test:service": "node scripts/test-runner.mjs --suite service",
    "test:ui:core": "node scripts/test-runner.mjs --suite ui-core --concurrency 2",
    "check:related": "node scripts/check-related.mjs",
    "check:related:watch": "node scripts/check-related.mjs --watch",
    "test:environment": "node scripts/test-runner.mjs --suite environment"
  },
  "checkPreflight": [
    "typecheck",
    "test:environment",
    "test:tooling",
    "test:rows"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@radix-ui/react-icons": "1.3.2",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tar-stream": "3.2.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "rolldown": "1.2.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.5"
  }
}
