      "review": "outputs/FH06-review.mp4"
    },
    {
      "id": "FH07",
      "segmentId": "5b18fddd-76d9-44f5-90e9-8663ff71e12c",
      "order": 7,
      "text": "此时，股骨头外形仍可能保持完整。",
      "voice": {
        "speaker": "zh_female_vv_uranus_bigtts",
        "speechRate": 0
      },
      "taskId": "83cc7d16-a2a0-4f43-a179-bbb884adcdc8",
      "audio": "public/audio/FH07.mp3",
      "durationInFrames": 116,
      "audioDuration": 3.864,
