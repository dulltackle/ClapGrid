    {
      "id": "FH05",
      "segmentId": "1e09a362-e6eb-4cf0-90bb-ce7f1d3b81c4",
      "order": 5,
      "text": "当局部血液供应受损，这里的骨组织就可能发生坏死。",
      "voice": {
        "speaker": "zh_female_vv_uranus_bigtts",
        "speechRate": 0
      },
      "taskId": "6658739d-4778-4f59-8ae6-a764ea8e36af",
      "audio": "public/audio/FH05.mp3",
      "durationInFrames": 146,
      "audioDuration": 4.848,
