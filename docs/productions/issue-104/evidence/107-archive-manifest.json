      "review": "outputs/FH07-review.mp4"
    },
    {
      "id": "FH08",
      "segmentId": "f27fcec6-b3b4-4048-9dd4-79eaa9cf6930",
      "order": 8,
      "text": "身体也会尝试修复受损区域。",
      "voice": {
        "speaker": "zh_female_vv_uranus_bigtts",
        "speechRate": 0
      },
      "taskId": "e59b50fd-4f54-4057-8612-611f4435ad4f",
