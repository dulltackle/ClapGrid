      "assembly": "outputs/FH05-assembly.mp4",
      "review": "outputs/FH05-review.mp4"
    },
    {
      "id": "FH06",
      "segmentId": "09985f81-72ee-43c5-bc56-0a48e78d7b0d",
      "order": 6,
      "text": "但细胞死亡，不等于原有的骨架马上消失。",
      "voice": {
        "speaker": "zh_female_vv_uranus_bigtts",
        "speechRate": 0
      },
      "taskId": "2ec5815c-42ad-4c0c-ba00-1ec664062a5f",
      "audio": "public/audio/FH06.mp3",
      "durationInFrames": 116,
      "audioDuration": 3.864,
